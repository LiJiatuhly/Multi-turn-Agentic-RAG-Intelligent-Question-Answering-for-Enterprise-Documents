# 复制为 project/.env 后填写，不要提交真实 .env。
API_KEY=在这里填入你的智谱APIKey
BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# RAG 回答模型与二阶段检索模型
MODEL_ID=glm-4.5-air
RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual

# Ragas 评测配置
JUDGE_MODEL_ID=glm-4.7
EVAL_EMBEDDING_MODEL=embedding-3
EVAL_JUDGE_MAX_TOKENS=8192
EVAL_JUDGE_MAX_WORKERS=1
EVAL_JUDGE_MAX_RETRIES=5
EVAL_JUDGE_MAX_WAIT=120
EVAL_JUDGE_DISABLE_THINKING=true

# Langfuse 可观测性（可选）
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000

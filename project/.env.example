# 这是模板文件。复制一份改名为 .env，把下面的值换成你自己的即可。
# ============================================================

# 智谱 API Key（在 https://open.bigmodel.cn/ 的「API 密钥」页面获取）
API_KEY=在这里填入你的智谱APIKey

# 智谱通用接口地址（保持默认即可）
BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# 使用的模型名。可选 glm-4.7 / glm-4.6 / glm-4.5-air / glm-5.1 等
MODEL_ID=glm-4.5-air

# Tavily 联网搜索 Key：当前项目没用到，可留空
TAVILY_API_KEY=

# Langfuse 可观测性（可选，默认关闭）
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=http://localhost:3000

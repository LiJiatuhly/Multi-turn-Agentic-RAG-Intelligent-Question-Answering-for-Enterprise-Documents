digraph Agent {
  rankdir=TB;
  bgcolor="transparent";
  nodesep=0.42;
  ranksep=0.48;
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC",
        fontsize=11, color="#2C5A8C", fillcolor="#EAF1F8", fontcolor="#16324F",
        penwidth=1.3, margin="0.14,0.08"];
  edge [fontname="Noto Sans CJK SC", fontsize=9.5, color="#5C6B7A",
        fontcolor="#33526E", penwidth=1.3, arrowsize=0.85];

  start [label="START", shape=oval, fillcolor="#2C5A8C", fontcolor="white", color="#22496F", fontsize=11];
  orch  [label=<<b>orchestrator</b><br/><font point-size="8.5" color="#5B6B7A">ReAct 循环体 · 带工具调模型 · 首轮强制先检索</font>>];
  dec1  [label=<<b>模型输出?</b><br/><font point-size="8.5" color="#8A6A22">route_after_...call</font>>,
         shape=diamond, fillcolor="#FCF1DA", color="#C79322", fontcolor="#7A5B15", margin="0.02,0.02"];
  tools [label=<<b>tools · ToolNode</b><br/><font point-size="8.5" color="#5B6B7A">真正执行检索工具</font>>,
         fillcolor="#E8F3EC", color="#2E7D52", fontcolor="#1E5638"];
  dec2  [label=<<b>上下文过长?</b><br/><font point-size="8.5" color="#8A6A22">should_compress</font>>,
         shape=diamond, fillcolor="#FCF1DA", color="#C79322", fontcolor="#7A5B15", margin="0.02,0.02"];
  comp  [label=<<b>compress_context</b><br/><font point-size="8.5" color="#5B6B7A">压成摘要 · 记已搜清单</font>>];
  fb    [label=<<b>fallback_response</b><br/><font point-size="8.5" color="#8A5A2A">用现有材料强行作答</font>>,
         fillcolor="#FBEEE3", color="#C77A3C", fontcolor="#7A4A22"];
  coll  [label=<<b>collect_answer</b><br/><font point-size="8.5" color="#5B6B7A">答案按 index 冒泡回主图</font>>];
  end   [label="END", shape=oval, fillcolor="#2C5A8C", fontcolor="white", color="#22496F", fontsize=11];

  start -> orch;
  orch -> dec1;

  // 无工具 = 答完了 -> 收集 -> END（走左侧）
  dec1 -> coll [label="无工具\n= 答完了", fontcolor="#B5651D"];
  coll -> end;

  // 预算耗尽 -> fallback -> 收集
  dec1 -> fb [label="预算耗尽\niter≥MAX / tools>MAX", fontcolor="#B5651D"];
  fb -> coll [constraint=false];

  // 有工具且预算足 -> 执行工具 -> 是否压缩
  dec1 -> tools [label="有工具 · 预算足", fontcolor="#2E7D52"];
  tools -> dec2;

  // 压缩后回 orchestrator；不压缩也回 orchestrator（右侧回环通道）
  dec2 -> comp [label="是", fontcolor="#B5651D"];
  comp -> orch [label="带摘要回 orch 继续检索", fontcolor="#2E7D52", constraint=false];
  dec2 -> orch [label="否", fontcolor="#B5651D", constraint=false];
}
